{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper Rotator",
  "version": "0.1.0",
  "identifier": "io.github.theacetwo.wallpaperrotator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Wallpaper Rotator",
        "width": 520,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Random wallpapers from your Immich album",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQTBDMTQ0RjFEQUQyM0QKUldROTB0cnhSTUdnejduZGRkYXUzRlFzTm1xbzFpekMyd3NGRnE2a01sejg1SmhSU0dBSkVvb3UK",
      "endpoints": [
        "https://github.com/TheAceTwo/WallpaperRotator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
